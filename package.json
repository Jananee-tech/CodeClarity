{
  "name": "codeclarity",
  "displayName": "CodeClarity",
  "description": "AI-powered code explanations for developers",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand: codeclarity.explainCode"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeclarity.explainCode",
        "title": "CodeClarity: Explain Selected Code"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.145.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "groq-sdk": "^1.6.0"
  }
}
